rules_version = '2';

// Daily Scoreboard security rules.
// Every friend has an account: a name and a password. Firebase needs an email for that, so a
// name maps to the private login address <name>@users.daily-scoreboard.app (src/records.js).
// Anyone signed in can read the scoreboard; an account can only write its own name (which must
// match its login) and its own results.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // players/{uid}: { name, joinedAt }
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if hasAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.name.lower() + '@users.daily-scoreboard.app'
             == request.auth.token.email;
      allow delete: if false;
    }

    // results/{date}_{game}_{uid}: one result per player, per game, per day.
    match /results/{resultId} {
      allow read: if signedIn();
      allow create, update: if hasAccount()
        && request.resource.data.uid == request.auth.uid
        && resultId == request.resource.data.date + '_' + request.resource.data.game
                       + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'player', 'game', 'puzzle', 'result', 'failed', 'date', 'submittedAt'])
        && request.resource.data.game in ['wordle', 'connections', 'dailytens', 'krillion']
        && request.resource.data.puzzle is int
        && request.resource.data.result is number
        && request.resource.data.failed is bool
        && request.resource.data.player is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if hasAccount() && resource.data.uid == request.auth.uid;
    }
  }
}

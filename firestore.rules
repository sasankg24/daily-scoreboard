rules_version = '2';

// Daily Scoreboard security rules.
// Every phone signs in anonymously and gets its own uid. Anyone signed in can read the
// scoreboard, but a phone can only write its own player name and its own results.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // players/{uid}: { name, joinedAt }
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20;
      allow delete: if false;
    }

    // results/{date}_{game}_{uid}: one result per player, per game, per day.
    match /results/{resultId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && resultId == request.resource.data.date + '_' + request.resource.data.game
                       + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'player', 'game', 'puzzle', 'result', 'failed', 'date', 'submittedAt'])
        && request.resource.data.game in ['wordle', 'connections', 'dailytens', 'krillion']
        && request.resource.data.puzzle is int
        && request.resource.data.result is number
        && request.resource.data.failed is bool
        && request.resource.data.player is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
